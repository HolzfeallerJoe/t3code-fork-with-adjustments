# git autocrlf=true converts LF to CRLF on Windows, causing issues with oxfmt
* text=auto eol=lf

# Batch files need CRLF for cmd.exe to parse them reliably.
*.cmd text eol=crlf
*.bat text eol=crlf

# Keep the fork's own release workflow; never merge upstream's version
/.github/workflows/release.yml merge=ours
